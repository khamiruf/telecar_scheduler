{
  "name": "telecar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "deploy": "npm run build && wrangler deploy --config dist/telecar/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply telecar --remote",
    "db:migrate:local": "wrangler d1 migrations apply telecar --local",
    "test": "vitest run"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
