{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telecar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telecar",
      "database_id": "068c1dde-1493-469e-813e-3bf4eb76ca17",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Chat id of the family group where notifications are posted.
    "GROUP_CHAT_ID": "REPLACE_WITH_GROUP_CHAT_ID"
  }
  // Secrets (set via `wrangler secret put <NAME>`, or .dev.vars locally):
  //   ADMIN_ID                - Telegram user id of the owner/admin. Always authorized; can add others via /add.
  //   TELEGRAM_BOT_TOKEN      - from @BotFather
  //   TELEGRAM_WEBHOOK_SECRET - random string, must match setWebhook secret_token
}
